rules_version = '2';

// ParkKo Firestore security rules.
// The repo is public, so anyone has the project coordinates. These rules are
// the actual access control — without them, test-mode leaves the DB open to
// anyone. Paste into Firebase Console -> Firestore Database -> Rules -> Publish.
//
// Model: a signed-in user may only create/read/update THEIR OWN user doc.
// Vacancy reports are world-readable, writable by any signed-in user (one of
// three valid statuses), and can never be deleted.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User profiles: users/{uid} ---
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role in ['host', 'driver']
                    && request.resource.data.email is string
                    && request.resource.data.name is string;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role in ['host', 'driver'];
      allow delete: if false;
    }

    // --- Crowd-sourced vacancy: vacancy/{lotId} ---
    // Public read (drivers need to see status without an account); writes
    // require sign-in and a valid status; never deletable.
    match /vacancy/{lotId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.level in ['open', 'some', 'full']
                   && request.resource.data.ts is string;
      allow delete: if false;
    }

    // Everything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
